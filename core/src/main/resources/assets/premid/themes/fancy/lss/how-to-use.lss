@import super();

.container {
  left: 50%;
  top: 50%;
  width: fit-content;
  height: fit-content;
  alignment-x: center;
  alignment-y: center;
  filter: blur(25);
  border-radius: 15;
  border-thickness: 5;
  border-color: var(--background-color-border);
  background-color: var(--background-color);
  box-shadow: none;

  .header {
    left: 50%;
    width: 100%;
    height: 25;
    padding: 0 2 0 2;
    space-between-entries: 5;
    background-color: rgba(76, 123, 247, 0.3);
    border-radius: 15 15 0 0;

    .title {
      alignment: center;
    }

  }

  .content {
    width: fit-content;
    height: fit-content;
    overwrite-width: false;

    .description-container {
      width: fit-content;
      height: fit-content;
      margin: 10 10 10 10;

      Component {
        alignment-x: center;
        margin-bottom: 10;
      }

      .open-settings-image, .enable-forwarding-image {
        margin: 0 0 10 0;
        alignment-x: center;
        width: 35%;
        height: 60;
      }

      .url-field {
        alignment-x: center;
        width: 60%;
        margin-bottom: 10;
        height: 25;
      }

    }

  }
}